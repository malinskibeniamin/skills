{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session-env.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/llm-env.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "Setup": [
      {
        "matcher": "init|maintenance",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/setup-init.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/user-prompt-context.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/intent-detect.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/skill-fire-log.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-compact-context.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-compact.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-tool-failure.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/cwd-changed.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/config-change-guard.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/task-completed-gate.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/stop-failure-telemetry.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/permission-denied-retry.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/notification-alert.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/file-changed-schema.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/file-changed-config.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "src/env.ts",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/file-changed-env.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "skill-manifest.json",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/file-changed-manifest.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "package.json|bun.lock|bun.lockb|yarn.lock|package-lock.json|go.mod|go.sum",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/file-changed-deps.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session-end.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/violation-nudge.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/copyright-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/skill-fire-log.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-bash.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/mcp-ban.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/llm-truncate.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/consecutive-failure-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/test-warning-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/subagent-start.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/subagent-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/stop-dispatch.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-tool-batch.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ]
  }
}
