{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session-env.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/llm-env.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/user-prompt-context.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/intent-detect.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-compact-context.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-compact.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/violation-nudge.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/skill-fire-log.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-bash.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/mcp-ban.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/vendor-file-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/react-rules-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/tailwind-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/accessibility-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/zustand-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/tanstack-router-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/tanstack-router-gen.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/connect-query-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/aip-proto-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/ux-copy-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/orchestration-guidance.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/form-mode-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/error-boundary-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/test-convention-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/ts-no-escape-hatches-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/tsconfig-strict-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/llm-failure-mode-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/security-audit-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/query-pattern-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/copyright-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/edit-loop-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/lockfile-sync-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/llm-truncate.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/consecutive-failure-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/test-warning-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-tool-failure.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/subagent-start.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "self-reviewer|code-reviewer|adversarial-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/subagent-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/biome-autofix.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/typecheck-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/react-doctor-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/registry-check.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/orchestration-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/test-perf-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/quality-gate-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/lifecycle-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pr-feedback-completeness-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/ci-warning-audit.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/violation-summary-stop.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/codex-permission-request-guard.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ]
  }
}
