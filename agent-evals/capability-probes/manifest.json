      "role": "current-codex-baseline"
    },
    {
      "agent": "claude-code",
      "id": "claude-fable-5-1",
      "effort": "max",
      "role": "cross-family-baseline"
    }
  ],
  "probes": [
    {
      "id": "spatial-computer-use",
      "execution": "manual",
      "capabilities": ["computer_use", "vision", "spatial_3d"],
