{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["actor", "target", "rule", "summary"],
  "properties": {
    "actor": {
      "type": "object",
      "properties": { "id": { "type": "string" } }
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "properties": { "name": { "type": "string" } }
    },
    "summary": { "type": "string" }
  }
}
