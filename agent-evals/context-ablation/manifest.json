{
  "schema_version": 2,
  "purpose": "Measure quality before deleting or adding ambient context.",
  "release_trigger": "major-model-release",
  "variants": ["bare", "guardrails", "lean", "current"],
  "metrics": [
    "task_success",
    "regressions",
    "human_quality",
    "input_tokens",
    "output_tokens",
    "duration_seconds",
    "verification_behavior"
  ],
  "runs_per_cell": 3,
  "tasks": [
    "setup-code-organization",
    "setup-accessibility",
    "violation-nudge",
    "aip-design-review",
    "self-verifying-repair"
  ],
  "capabilities": {
    "codex": {
      "models": [
        {
          "id": "gpt-5.6-sol",
          "efforts": ["xhigh", "max"]
        }
      ]
    },
    "claude-code": {
      "minimum_cli_version": "2.1.257",
      "models": [
        {
          "id": "claude-fable-5-1",
          "efforts": ["low", "medium", "high", "xhigh", "max"]
        },
        {
          "id": "claude-opus-5",
          "efforts": ["high", "xhigh"]
        }
      ]
    }
  },
  "gate": {
    "quality": "No lower task success, no new high-severity regression, and median human-quality score no lower than current.",
    "efficiency": "Among quality-equivalent cells, prefer fewer input tokens and shorter duration.",
    "method": "Start from the bare model and restore guardrails, lean repository context, then current context. Change one group at a time."
  },
  "promotion_record": {
    "template": "agent-evals/context-ablation/scorecard-template.md",
    "required_fields": [
      "model_version",
      "harness_commit",
      "task_pass_rates",
      "quality_verdict",
      "winning_variant",
      "hook_retention_decisions",
      "skill_retention_decisions",
      "saturated_tasks"
    ]
  }
}
