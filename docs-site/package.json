{
  "name": "@frontend-skills/docs",
  "type": "module",
  "private": true,
  "imports": {
    "#blume-filesystem": {
      "types": "./blume-filesystem.d.ts",
      "default": "blume/sources/filesystem.ts"
    }
  },
  "scripts": {
    "audit": "blume audit --only accessibility --fail-on warning",
    "build": "blume build",
    "test:browser": "playwright test --config playwright.config.ts",
    "check": "blume check --strict",
    "dev": "blume dev",
    "diagrams": "bun run generate-skill-diagrams.ts --render",
    "docs:version": "bun run version-docs.ts",
    "translate": "blume translate --codex",
    "translate:check": "blume translate --check"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "blume": "2.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}
