{
  "$comment": "Source of truth for all hook configurations. Generates .claude/settings.json, hooks/hooks.json, .claude-plugin/plugin.json counts, .codex-plugin/plugin.json counts, .agents/plugins/marketplace.json, .claude-plugin/marketplace.json. Run scripts/generate-hook-configs.sh to regenerate. Entries are either a script filename string or an object {script, if, async, statusMessage, timeout}; asyncRewake is prohibited by the completion contract. Extra fields are Claude-only (Codex configs keep the bare command; `if` gating falls back to the script's own input guard there).",
  "version": "4.34.0",
  "hooks": {
    "SessionStart": {
      "": ["session-env.sh", "llm-env.sh"]
    },
    "Setup": {
      "init|maintenance": ["setup-init.sh"]
    },
    "UserPromptSubmit": {
      "": ["user-prompt-context.sh", "intent-detect.sh"]
    },
    "UserPromptExpansion": {
      "": ["skill-fire-log.sh"]
    },
    "PostCompact": {
      "": ["post-compact-context.sh"]
    },
    "PreCompact": {
      "": ["pre-compact.sh"]
    },
    "PostToolUseFailure": {
      "Bash": ["post-tool-failure.sh"]
    },
    "CwdChanged": {
      "": ["cwd-changed.sh"]
    },
    "ConfigChange": {
      "project_settings": ["config-change-guard.sh"]
    },
    "TaskCompleted": {
      "": ["task-completed-gate.sh"]
    },
    "StopFailure": {
      "": ["stop-failure-telemetry.sh"]
    },
    "PermissionDenied": {
      "Bash": ["permission-denied-retry.sh"]
    },
    "Notification": {
      "permission_prompt|idle_prompt|agent_needs_input|agent_completed": [
        "notification-alert.sh"
      ]
    },
    "FileChanged": {
      "": ["file-changed-schema.sh", "file-changed-config.sh"],
      "src/env.ts": ["file-changed-env.sh"],
      "skill-manifest.json": ["file-changed-manifest.sh"],
      "package.json|bun.lock|bun.lockb|yarn.lock|package-lock.json|go.mod|go.sum": [
        "file-changed-deps.sh"
      ]
    },
    "SessionEnd": {
      "": ["session-end.sh"]
    },
    "PreToolUse": {
      "Edit|Write|Bash": ["violation-nudge.sh"],
      "Skill": ["skill-fire-log.sh"],
      "Bash": ["pre-bash.sh"],
      "mcp__.*": ["mcp-ban.sh"]
    },
    "PostToolUse": {
      "Bash": [
        "llm-truncate.sh",
        "consecutive-failure-check.sh",
        "test-warning-check.sh"
      ]
    },
    "SubagentStart": {
      "": ["subagent-start.sh"]
    },
    "SubagentStop": {
      "": ["subagent-stop.sh"]
    },
    "Stop": {
      "": ["stop-dispatch.sh"]
    },
    "PostToolBatch": {
      "": ["post-tool-batch.sh"]
    }
  },
  "x-stop-dispatch": [
    "biome-autofix.sh",
    "typecheck-stop.sh",
    "react-doctor-stop.sh",
    "registry-check.sh",
    "orchestration-stop.sh",
    "test-perf-stop.sh",
    "quality-gate-stop.sh",
    "dogfood-stop.sh",
    "lifecycle-stop.sh",
    "pr-feedback-completeness-stop.sh",
    "suppression-gate-stop.sh",
    "violation-summary-stop.sh",
    "completion-contract-stop.sh"
  ],
  "x-codex-edit-dispatch": "codex-edit-dispatch.sh",
  "x-post-tool-checks": [
    "vendor-file-check.sh",
    "react-rules-check.sh",
    "tailwind-check.sh",
    "accessibility-check.sh",
    "zustand-check.sh",
    "tanstack-router-check.sh",
    "tanstack-table-check.sh",
    "tanstack-router-gen.sh",
    "connect-query-check.sh",
    "aip-proto-check.sh",
    "go-proto-reserved-check.sh",
    "go-test-image-pin-check.sh",
    "ux-copy-check.sh",
    "orchestration-guidance.sh",
    "form-mode-check.sh",
    "error-boundary-check.sh",
    "test-convention-check.sh",
    "ts-no-escape-hatches-check.sh",
    "tsconfig-strict-check.sh",
    "llm-failure-mode-check.sh",
    "query-pattern-check.sh",
    "copyright-check.sh",
    "edit-loop-check.sh",
    "lockfile-sync-check.sh"
  ]
}
