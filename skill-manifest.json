{
  "$comment": "Source of truth for all hook configurations. Generates .claude/settings.json, hooks/hooks.json, .claude-plugin/plugin.json counts, .codex-plugin/plugin.json counts, .agents/plugins/marketplace.json, .claude-plugin/marketplace.json. Run scripts/generate-hook-configs.sh to regenerate.",
  "version": "4.29.0",
  "hooks": {
    "SessionStart": {
      "": [
        "session-env.sh",
        "llm-env.sh"
      ]
    },
    "UserPromptSubmit": {
      "": [
        "user-prompt-context.sh",
        "intent-detect.sh"
      ]
    },
    "PostCompact": {
      "": [
        "post-compact-context.sh"
      ]
    },
    "PreCompact": {
      "": [
        "pre-compact.sh"
      ]
    },
    "PostToolUseFailure": {
      "Bash": [
        "post-tool-failure.sh"
      ]
    },
    "FileChanged": {
      "*.proto|*.graphql|*.graphqls": [
        "file-changed-schema.sh"
      ],
      "biome.jsonc|biome.json|tsconfig.json|tsconfig.*.json|vitest.config.*": [
        "file-changed-config.sh"
      ],
      "src/env.ts": [
        "file-changed-env.sh"
      ],
      "skill-manifest.json": [
        "file-changed-manifest.sh"
      ],
      "package.json|bun.lock|bun.lockb|yarn.lock|package-lock.json|go.mod|go.sum": [
        "file-changed-deps.sh"
      ]
    },
    "SessionEnd": {
      "": [
        "session-end.sh"
      ]
    },
    "PreToolUse": {
      "Edit|Write|Bash": [
        "violation-nudge.sh"
      ],
      "Skill": [
        "skill-fire-log.sh"
      ],
      "Bash": [
        "pre-bash.sh"
      ],
      "mcp__.*": [
        "mcp-ban.sh"
      ]
    },
    "PostToolUse": {
      "Bash": [
        "llm-truncate.sh",
        "consecutive-failure-check.sh",
        "test-warning-check.sh"
      ]
    },
    "SubagentStart": {
      "": [
        "subagent-start.sh"
      ]
    },
    "SubagentStop": {
      "self-reviewer|code-reviewer|adversarial-reviewer": [
        "subagent-stop.sh"
      ]
    },
    "Stop": {
      "": [
        "biome-autofix.sh",
        "typecheck-stop.sh",
        "react-doctor-stop.sh",
        "registry-check.sh",
        "orchestration-stop.sh",
        "test-perf-stop.sh",
        "quality-gate-stop.sh",
        "lifecycle-stop.sh",
        "pr-feedback-completeness-stop.sh",
        "ci-warning-audit.sh",
        "violation-summary-stop.sh"
      ]
    },
    "PostToolBatch": {
      "": [
        "post-tool-batch.sh"
      ]
    }
  },
  "x-codex-per-call": [
    "vendor-file-check.sh",
    "react-rules-check.sh",
    "tailwind-check.sh",
    "accessibility-check.sh",
    "zustand-check.sh",
    "tanstack-router-check.sh",
    "tanstack-router-gen.sh",
    "connect-query-check.sh",
    "aip-proto-check.sh",
    "ux-copy-check.sh",
    "orchestration-guidance.sh",
    "form-mode-check.sh",
    "error-boundary-check.sh",
    "test-convention-check.sh",
    "ts-no-escape-hatches-check.sh",
    "tsconfig-strict-check.sh",
    "llm-failure-mode-check.sh",
    "query-pattern-check.sh",
    "copyright-check.sh",
    "edit-loop-check.sh",
    "lockfile-sync-check.sh"
  ]
}
